@model DonationManagementSystem.Web.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <h1 class="mb-4">Featured Donation Cases</h1>

    <!-- Featured Cases Grid -->
    <div class="row mb-5">
        @foreach (var item in Model.FeaturedCases)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(item.Case.ImagePath))
                    {
                        <img src="@item.Case.ImagePath" class="card-img-top" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Case.Title</h5>
                        <p class="card-text">@item.Case.Description.Substring(0, Math.Min(100, item.Case.Description.Length))...</p>
                        
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Collected: <strong>@item.Collected.ToString("C")</strong></span>
                                <span>Target: <strong>@item.Case.TargetAmount.ToString("C")</strong></span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-success" style="width: @item.ProgressPercent%"></div>
                            </div>
                            <small class="text-muted">@item.ProgressPercent% • @item.DonorCount donors</small>
                        </div>
                        
                        <a href="/DonationCases/Details/@item.Case.Id" class="btn btn-primary btn-sm w-100">
                            View & Donate
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Other Cases -->
    @if (Model.Others.Any())
    {
        <h2 class="mb-4">Other Cases</h2>
        <div class="row">
            @foreach (var item in Model.Others)
            {
                <div class="col-md-6 mb-3">
                    <div class="card">
                        <div class="row g-0">
                            <div class="col-md-4">
                                @if (!string.IsNullOrWhiteSpace(item.Case.ImagePath))
                                {
                                    <img src="@item.Case.ImagePath" class="img-fluid" style="height: 150px; object-fit: cover;" />
                                }
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h6 class="card-title">@item.Case.Title</h6>
                                    <div class="progress mb-2" style="height: 8px;">
                                        <div class="progress-bar bg-success" style="width: @item.ProgressPercent%"></div>
                                    </div>
                                    <small class="text-muted">@item.Collected.ToString("C") / @item.Case.TargetAmount.ToString("C")</small>
                                    <br />
                                    <a href="/DonationCases/Details/@item.Case.Id" class="btn btn-sm btn-outline-primary mt-2">Donate</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- CTA -->
    <div class="alert alert-info mt-5">
        <h4>Want to help?</h4>
        <p>Browse through our donation cases and help change lives today!</p>
        <a href="/Home/Search" class="btn btn-primary">Advanced Search</a>
    </div>
</div>