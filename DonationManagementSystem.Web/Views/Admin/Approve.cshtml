@{
    ViewData["Title"] = "Approve Case";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title mb-4">Approve Case</h3>
                    
                    <div class="alert alert-info">
                        <strong>Case:</strong> @ViewBag.CaseTitle
                    </div>

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="caseId" value="@ViewBag.CaseId" />
                        
                        <div class="mb-3">
                            <label class="form-label">Admin Note (Optional)</label>
                            <textarea class="form-control" name="note" rows="4" placeholder="Add notes..."></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" formaction="/Admin/ApproveConfirm" class="btn btn-success flex-grow-1">
                                Confirm Approval
                            </button>
                            <a href="/Admin/PendingCases" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>