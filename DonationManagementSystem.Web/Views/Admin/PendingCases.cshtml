@model List<DonationManagementSystem.Domain.Entities.DonationCase>

@{
    ViewData["Title"] = "Pending Cases";
}

<div class="container mt-5">
    <h2 class="mb-4">Pending Cases for Review</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p>No pending cases at the moment.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Target</th>
                        <th>Category</th>
                        <th>Submitted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <strong>@item.Title</strong><br />
                                <small class="text-muted">@item.Description.Substring(0, Math.Min(50, item.Description.Length))...</small>
                            </td>
                            <td>@item.TargetAmount.ToString("C")</td>
                            <td>@item.Category?.Name</td>
                            <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <a href="/Admin/Approve/@item.Id" class="btn btn-sm btn-success">Approve</a>
                                <a href="/Admin/Reject/@item.Id" class="btn btn-sm btn-danger">Reject</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>