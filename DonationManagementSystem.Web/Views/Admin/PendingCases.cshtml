@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@model List<DonationManagementSystem.Domain.Entities.DonationCase>

@{
    ViewData["Title"] = "Pending Donation Cases";
}

<div class="mb-4">
    <h2>Pending Cases Review</h2>
    <p class="text-muted">Review and approve or reject pending donation cases</p>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <p class="text-muted">No pending cases to review.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Target Amount</th>
                        <th>Submitted By</th>
                        <th>Date</th>
                        <th style="width:280px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var user = await UserManager.FindByIdAsync(item.CreatedByUserId);
                        var email = user?.Email ?? "unknown";
                        var username = email.Contains("@") ? email.Split('@')[0] : email;

                        <tr>
                            <td>
                                <strong>@(item.Title.Length > 40 ? item.Title.Substring(0, 40) + "..." : item.Title)</strong>
                            </td>
                            <td>@item.TargetAmount.ToString("C")</td>
                            <td><small>@username</small></td>
                            <td><small>@item.CreatedAt.ToString("yyyy-MM-dd")</small></td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="/DonationCases/Details/@item.Id" class="btn btn-outline-info" target="_blank">View</a>

                                    <form asp-action="Approve" method="post" style="display:inline;" onsubmit="return confirm('Approve this case?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="note" value="" />
                                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                    </form>

                                    <form asp-action="Reject" method="post" style="display:inline;" onsubmit="return confirm('Reject this case?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="note" value="" />
                                        <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
