@{
    ViewData["Title"] = "Reject Case";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title mb-4">Reject Case</h3>
                    
                    <div class="alert alert-warning">
                        <strong>Case:</strong> @ViewBag.CaseTitle
                    </div>

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="caseId" value="@ViewBag.CaseId" />
                        
                        <div class="mb-3">
                            <label class="form-label">Rejection Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" name="note" rows="4" placeholder="Explain why..." required></textarea>
                            <small class="text-muted">This will be sent to the user</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" formaction="/Admin/RejectConfirm" class="btn btn-danger flex-grow-1">
                                Confirm Rejection
                            </button>
                            <a href="/Admin/PendingCases" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>