@model DonationManagementSystem.Web.ViewModels.Dashboard.UserDashboardVm
@{
    ViewData["Title"] = "My Dashboard";
}

<h2>My Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-3 mb-2">
        <div class="card p-3">
            <div class="text-muted">My Cases</div>
            <h3>@Model.MyCasesCount</h3>
        </div>
    </div>

    <div class="col-md-3 mb-2">
        <div class="card p-3">
            <div class="text-muted">My Payments</div>
            <h3>@Model.MyPaymentsCount</h3>
        </div>
    </div>

    <div class="col-md-3 mb-2">
        <div class="card p-3">
            <div class="text-muted">Total Donated (Approved)</div>
            <h3>@Model.TotalDonatedApproved</h3>
        </div>
    </div>

    <div class="col-md-3 mb-2">
        <div class="card p-3">
            <div class="text-muted">Pending / Approved / Rejected</div>
            <h5>@Model.PendingPaymentsCount / @Model.ApprovedPaymentsCount / @Model.RejectedPaymentsCount</h5>
        </div>
    </div>
</div>

<h4>Latest My Cases</h4>
@if (!Model.LatestCases.Any())
{
    <p class="text-muted">No cases yet.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.LatestCases)
            {
                <tr>
                    <td>@c.Title</td>
                    <td>@c.Status</td>
                    <td>@c.CreatedAt</td>
                </tr>
            }
        </tbody>
    </table>
}

<h4 class="mt-4">Latest My Payments</h4>
@if (!Model.LatestPayments.Any())
{
    <p class="text-muted">No payments yet.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Case</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.LatestPayments)
            {
                <tr>
                    <td>@p.DonationCase?.Title</td>
                    <td>@p.Amount</td>
                    <td>@p.Status</td>
                    <td>@p.CreatedAt</td>
                </tr>
            }
        </tbody>
    </table>
}
