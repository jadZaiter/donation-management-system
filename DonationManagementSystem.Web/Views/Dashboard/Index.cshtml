@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">
    <h2 class="mb-4">Dashboard</h2>

    <div class="row">
        <!-- My Cases Card -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">My Cases</h5>
                    <p class="card-text text-muted">View and manage your submitted donation cases</p>
                    <a href="/DonationCases/MyCases" class="btn btn-primary">View My Cases</a>
                </div>
            </div>
        </div>

        <!-- My Payments Card -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">My Payments</h5>
                    <p class="card-text text-muted">Track your donations and payment status</p>
                    <a href="/DonationCases/MyPayments" class="btn btn-primary">View My Payments</a>
                </div>
            </div>
        </div>

        <!-- Browse Cases Card -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Browse Cases</h5>
                    <p class="card-text text-muted">Discover and support other donation cases</p>
                    <a href="/Home/Search" class="btn btn-primary">Search Cases</a>
                </div>
            </div>
        </div>

        <!-- Submit Case Card -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Submit Case</h5>
                    <p class="card-text text-muted">Create a new donation case to help others</p>
                    <a href="/DonationCases/Create" class="btn btn-primary">Submit New Case</a>
                </div>
            </div>
        </div>
    </div>
</div>