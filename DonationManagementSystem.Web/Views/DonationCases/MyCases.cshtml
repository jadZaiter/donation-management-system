@model List<DonationManagementSystem.Domain.Entities.DonationCase>

@{
    ViewData["Title"] = "My Cases";
}

<div class="container mt-5">
    <h2 class="mb-4">My Donation Cases</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p>You haven't submitted any donation cases yet.</p>
            <a href="/DonationCases/Create" class="btn btn-primary">Submit Your First Case</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Target</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusBadgeClass = item.Status == DonationManagementSystem.Domain.Entities.CaseStatus.Pending ? "bg-warning" :
                                              item.Status == DonationManagementSystem.Domain.Entities.CaseStatus.Approved ? "bg-success" : "bg-danger";

                        <tr>
                            <td>
                                <strong>@item.Title</strong><br />
                                <small class="text-muted">@item.Description.Substring(0, Math.Min(50, item.Description.Length))...</small>
                            </td>
                            <td>@item.TargetAmount.ToString("C")</td>
                            <td>
                                <span class="badge @statusBadgeClass">@item.Status</span>
                            </td>
                            <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (item.Status == DonationManagementSystem.Domain.Entities.CaseStatus.Approved)
                                {
                                    <a href="/DonationCases/Details/@item.Id" class="btn btn-sm btn-primary">View</a>
                                }
                                else
                                {
                                    <span class="text-muted">Pending Review</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
