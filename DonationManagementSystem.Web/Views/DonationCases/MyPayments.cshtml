@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@using DonationManagementSystem.Domain.Entities

@model List<DonationManagementSystem.Domain.Entities.Payment>

@{
    ViewData["Title"] = "My Payments";
}

<div class="container mt-5">
    <h2 class="mb-4">My Payments</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p>You haven't made any donations yet.</p>
            <a href="/Home/Search" class="btn btn-primary">Browse Cases</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Case</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Method</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        var statusBadgeClass = payment.Status == DonationManagementSystem.Domain.Entities.PaymentStatus.Pending ? "bg-warning" :
                                              payment.Status == DonationManagementSystem.Domain.Entities.PaymentStatus.ProofUploaded ? "bg-info" :
                                              payment.Status == DonationManagementSystem.Domain.Entities.PaymentStatus.Approved ? "bg-success" : "bg-danger";

                        <tr>
                            <td>
                                <strong>@payment.DonationCase?.Title</strong>
                            </td>
                            <td>@payment.Amount.ToString("C")</td>
                            <td>
                                <span class="badge @statusBadgeClass">@payment.Status</span>
                            </td>
                            <td>@payment.Method</td>
                            <td>@payment.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (payment.Status == DonationManagementSystem.Domain.Entities.PaymentStatus.Pending)
                                {
                                    <a href="/DonationCases/UploadProof/@payment.Id" class="btn btn-sm btn-primary">Upload Proof</a>
                                }
                                @if (payment.Status == DonationManagementSystem.Domain.Entities.PaymentStatus.ProofUploaded)
                                {
                                    <span class="text-muted">Awaiting Review</span>
                                }
                                @if (!string.IsNullOrEmpty(payment.ProofPath))
                                {
                                    <a href="@payment.ProofPath" target="_blank" class="btn btn-sm btn-secondary">View Proof</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
