@model DonationManagementSystem.Domain.Entities.DonationCase

@{
    ViewData["Title"] = "Case Details";

    var collected = (decimal)ViewBag.Collected;
    var isOwner = (bool?)ViewBag.IsOwner ?? false;
    var isAdmin = (bool?)ViewBag.IsAdmin ?? false;
    var pct = Model.TargetAmount <= 0
        ? 0
        : (int)Math.Min(100, Math.Round((double)(collected / Model.TargetAmount * 100)));

    var isClosed = Model.Status == DonationManagementSystem.Domain.Entities.CaseStatus.Completed
                || collected >= Model.TargetAmount;
}

<h2 class="mb-4">@Model.Title</h2>

<!-- Show status if pending, rejected, etc -->
@if (Model.Status != DonationManagementSystem.Domain.Entities.CaseStatus.Approved)
{
    <div class="alert alert-warning mb-4">
        <strong>Status:</strong> @Model.Status
        @if (Model.Status == DonationManagementSystem.Domain.Entities.CaseStatus.Pending)
        {
            <br />
            <small>This case is awaiting admin approval.</small>
        }
        @if (Model.Status == DonationManagementSystem.Domain.Entities.CaseStatus.Rejected && !string.IsNullOrEmpty(Model.AdminNote))
        {
            <br />
            <small><strong>Rejection Reason:</strong> @Model.AdminNote</small>
        }
    </div>
}

<div class="row mb-4">
    <div class="col-lg-8">
        @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
        {
            <a href="@Model.ImagePath" target="_blank">
                <img src="@Model.ImagePath"
                     class="img-fluid rounded mb-3"
                     style="max-height:450px; object-fit:cover; width:100%; cursor:zoom-in;" />
            </a>
            <small class="text-muted d-block mb-3">Click image to view full size</small>
        }
        else
        {
            <div class="bg-light rounded p-5 text-center text-muted mb-3">
                <p>No image provided.</p>
            </div>
        }

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Case Details</h5>
                <p>@Model.Description</p>
            </div>
        </div>

        @if (Model.Status == DonationManagementSystem.Domain.Entities.CaseStatus.Approved)
        {
            <div class="alert alert-success">
                <strong>? Verified by admin</strong>
                @if (Model.ReviewedAt != null)
                {
                    <span>on @Model.ReviewedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                {
                    <div class="mt-2"><strong>Note:</strong> @Model.AdminNote</div>
                }
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-4 position-sticky" style="top: 20px;">
            <div class="card-body">
                <h5 class="card-title mb-4">Fundraising Progress</h5>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Collected</span>
                        <strong class="text-primary">@collected.ToString("C")</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Target</span>
                        <strong>@Model.TargetAmount.ToString("C")</strong>
                    </div>

                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width:@pct%">
                        </div>
                    </div>

                    <div class="text-center mt-2">
                        <span class="badge bg-info">@pct% Complete</span>
                    </div>
                </div>

                <hr />

                <h6 class="mb-3">Make a Donation</h6>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (Model.Status == DonationManagementSystem.Domain.Entities.CaseStatus.Approved)
                    {
                        <form asp-action="Donate" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="CaseId" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label">Amount to Donate</label>
                                <input class="form-control form-control-lg"
                                       type="number"
                                       name="Amount"
                                       min="1"
                                       step="0.01"
                                       placeholder="0.00"
                                       required
                                       @(isClosed ? "disabled" : "") />
                            </div>

                            <button class="btn btn-primary w-100" @(isClosed ? "disabled" : "")>
                                Donate Now
                            </button>

                            @if (isClosed)
                            {
                                <div class="alert alert-success mt-3 mb-0">
                                    ? Target reached. This case is now closed.
                                </div>
                            }
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <small>This case is not yet approved. You can donate once it's approved by the admin.</small>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted"><a href="/Identity/Account/Login" class="text-decoration-none">Sign in</a> to make a donation.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Comments section (only for approved cases) -->
@if (Model.Status == DonationManagementSystem.Domain.Entities.CaseStatus.Approved)
{
    <hr />

    <h5 class="mb-4">Comments & Discussion</h5>

    @if (Model.Comments.Any())
    {
        <div class="mb-4">
            @foreach (var c in Model.Comments.OrderByDescending(x => x.CreatedAt))
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <strong>@c.UserId</strong>
                                <small class="text-muted">@c.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </div>
                        </div>
                        <p class="card-text mb-0">@c.Text</p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No comments yet. Be the first to comment!</p>
    }

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="card">
            <div class="card-body">
                <h6 class="card-title mb-3">Add a Comment</h6>
                <form asp-action="AddComment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="caseId" value="@Model.Id" />

                    <div class="mb-3">
                        <textarea class="form-control" name="text" rows="3" placeholder="Share your thoughts..." required></textarea>
                    </div>

                    <button class="btn btn-secondary">Post Comment</button>
                </form>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted"><a href="/Identity/Account/Login" class="text-decoration-none">Sign in</a> to leave a comment.</p>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
