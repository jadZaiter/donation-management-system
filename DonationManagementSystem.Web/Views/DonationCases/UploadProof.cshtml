@{
    ViewData["Title"] = "Upload Payment Proof";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <h3 class="card-title mb-4">Upload Payment Proof</h3>

                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @TempData["Message"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <p class="text-muted mb-4">
                        Please upload a screenshot or image of your payment proof (bank transfer confirmation, receipt, etc.)
                    </p>

                    <form method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label">Payment Proof Image (JPG/PNG, Max 5MB) *</label>
                            <div class="form-control-file border-2 border-dashed rounded p-5 text-center" style="cursor: pointer;">
                                <input type="file" name="proofFile" id="proofFile" class="form-control d-none" 
                                       accept="image/jpeg,image/png" required />
                                <label for="proofFile" style="cursor: pointer;">
                                    <i class="bi bi-cloud-upload" style="font-size: 2rem; color: #0d6efd;"></i>
                                    <p class="mt-2 mb-0"><strong>Click to upload</strong> or drag and drop</p>
                                    <p class="text-muted mb-0">PNG, JPG up to 5MB</p>
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2" id="fileName"></small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                Submit Proof
                            </button>
                            <a href="/DonationCases/MyPayments" class="btn btn-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const fileInput = document.getElementById('proofFile');
    const fileNameDisplay = document.getElementById('fileName');
    const dropZone = fileInput.parentElement;

    fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
            fileNameDisplay.textContent = `Selected: ${file.name}`;
        }
    });

    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('bg-light');
    });

    dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('bg-light');
    });

    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('bg-light');
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            fileInput.files = files;
            fileNameDisplay.textContent = `Selected: ${files[0].name}`;
        }
    });

    dropZone.addEventListener('click', () => fileInput.click());
</script>
