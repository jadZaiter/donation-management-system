@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@using DonationManagementSystem.Domain.Entities

@model List<DonationManagementSystem.Domain.Entities.Payment>

<div class=\"mb-4\">
    <h2>My Payments</h2>
    <p class=\"text-muted\">Track the status of your payment submissions</p>
</div>

@if (!Model.Any())
{
    <div class=\"card\">
        <div class=\"card-body text-center py-5\">
            <p class=\"text-muted\">No payments yet.</p>
        </div>
    </div>
}
else
{
    <div class=\"card\">
        <div class=\"table-responsive\">
            <table class=\"table table-hover mb-0\">
                <thead class=\"table-light\">
                    <tr>
                        <th>Case</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Proof</th>
                        <th>Submitted</th>
                        <th>Review Info</th>
                        <th>Admin Note</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in Model)
                    {
                        // Status badge
                        var badge = p.Status switch
                        {
                            PaymentStatus.Pending => \"bg-secondary\",
                            PaymentStatus.ProofUploaded => \"bg-warning text-dark\",
                            PaymentStatus.Approved => \"bg-success\",
                            PaymentStatus.Rejected => \"bg-danger\",
                            _ => \"bg-secondary\"
                        };

                        // Reviewed info
                        string reviewerName = \"—\";
                        if (!string.IsNullOrWhiteSpace(p.ReviewedByUserId))
                        {
                            var reviewer = await UserManager.FindByIdAsync(p.ReviewedByUserId);
                            var reviewerEmail = reviewer?.Email;

                            if (!string.IsNullOrWhiteSpace(reviewerEmail))
                                reviewerName = reviewerEmail.Contains(\"@\") ? reviewerEmail.Split('@')[0] : reviewerEmail;
                            else
                                reviewerName = \"Admin\";
                        }

                        var reviewedText = p.ReviewedAt.HasValue
                        ? $\"{reviewerName} • {p.ReviewedAt.Value:yyyy-MM-dd HH:mm}\"
                        : \"Pending review\";

                        <tr>
                            <td>
                                <strong>@(p.DonationCase?.Title != null && p.DonationCase.Title.Length > 30 ? p.DonationCase.Title.Substring(0, 30) + \"...\" : p.DonationCase?.Title ?? \"—\")</strong>
                            </td>
                            <td>
                                <strong class=\"text-success\">@p.Amount.ToString(\"C\")</strong>
                            </td>

                            <td>
                                <span class=\"badge @badge\">@p.Status</span>
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(p.ProofPath))
                                {
                                    <a href=\"@p.ProofPath\" target=\"_blank\" class=\"btn btn-sm btn-outline-primary\">View</a>
                                }
                                else
                                {
                                    <span class=\"text-muted\">—</span>
                                }
                            </td>

                            <td><small>@p.CreatedAt.ToString(\"yyyy-MM-dd HH:mm\")</small></td>
                            <td><small>@reviewedText</small></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(p.AdminNote))
                                {
                                    <small class=\"text-muted\">@(p.AdminNote.Length > 20 ? p.AdminNote.Substring(0, 20) + \"...\" : p.AdminNote)</small>
                                }
                                else
                                {
                                    <span class=\"text-muted\">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
